# 🚂 Railway Deployment Configuration
# Environment variables for Railway deployment

# Telegram Configuration (Required)
BOT_TOKEN=your_bot_token_here
CHAT_ID=your_chat_id_here

# Railway Optimized Settings
NODE_ENV=production
PORT=3000

# File Processing Limits
# Keep at 50MB due to Telegram Bot API upload limits
MAX_FILE_SIZE_MB=50

# Video duration limit (Railway can handle longer, but consider processing time)
# Free tier: 1800 seconds (30 min) recommended
# Paid tiers: 3600 seconds (60 min) or more
MAX_DURATION_SECONDS=1800

# Logging (Railway has good log management)
LOG_LEVEL=info

# Railway uses /tmp for temporary files
TEMP_DIR=/tmp

# Optional: Admin chat ID for management commands
ADMIN_CHAT_ID=your_admin_chat_id

# Railway Database URL (if using Railway PostgreSQL)
# DATABASE_URL=postgresql://...

# Memory optimization for Railway
NODE_OPTIONS=--max-old-space-size=512
